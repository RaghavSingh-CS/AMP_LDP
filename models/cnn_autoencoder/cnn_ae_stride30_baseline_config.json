  },
  "training_population": "usable stride-30 train windows with FLAG == 0 only",
  "early_stopping_population": "usable stride-30 validation windows with FLAG == 0 only",
  "scaling_assumption": "Stage 1 log1p consumption transformed by the Stage 2 training-fitted feature-wise StandardScaler",
  "future_threshold_policy": "normal_validation_95th_percentile",
  "test_set_policy": "not loaded or used during CNN training",
  "latent_dimension_note": "Latent dimension 8 follows convolutional compression to 16x5; it is not a latent-dimension sweep against the FC latent size 4."
