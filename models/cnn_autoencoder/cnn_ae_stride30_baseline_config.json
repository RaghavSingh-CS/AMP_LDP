  "seed": 42,
  "num_workers": 0,
  "input_policy": {
    "included": [
      "one channel of 30 StandardScaled consumption values"
    ],
    "excluded": [
      "CONS_NO",
      "FLAG",
      "missingness mask",
      "missing_count",
      "missing_fraction",
      "dates",
      "window_id"
