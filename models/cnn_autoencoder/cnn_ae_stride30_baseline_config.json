        "stride": 3,
        "padding": 0,
        "output_padding": 0,
        "output_shape": [
          8,
          15
        ]
      },
      {
        "layer": "ReLU"
      },
      {
        "layer": "ConvTranspose1d",
        "in_channels": 8,
        "out_channels": 1,
        "kernel_size": 2,
        "stride": 2,
        "padding": 0,
        "output_padding": 0,
        "output_shape": [
          1,
          30
        ]
      }
    ],
    "output_activation": "Linear",
    "shape_adjustment": "none; transposed-convolution arithmetic yields length 30 exactly"
  },
  "trainable_parameters": 2209,
  "input_shape": [
    1,
    30
  ],
  "output_shape": [
    1,
    30
  ],
  "window_length": 30,
  "stride": 30,
  "loss": "MSELoss",
  "optimizer": "Adam",
  "learning_rate": 0.001,
