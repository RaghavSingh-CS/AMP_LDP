          8,
          15
        ]
      },
      {
        "layer": "Conv1d",
        "in_channels": 8,
        "out_channels": 16,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "output_shape": [
          16,
          15
        ]
      },
      {
        "layer": "ReLU"
      },
      {
        "layer": "MaxPool1d",
        "kernel_size": 3,
        "stride": 3,
        "output_shape": [
          16,
          5
        ]
      },
      {
        "layer": "Flatten",
        "output_features": 80
      },
      {
        "layer": "Linear",
        "in_features": 80,
        "out_features": 8
      },
      {
        "layer": "ReLU"
      }
    ],
    "latent_dimension": 8,
    "decoder": [
      {
        "layer": "Linear",
        "in_features": 8,
        "out_features": 80
      },
      {
        "layer": "ReLU"
      },
      {
        "layer": "Reshape",
        "output_shape": [
