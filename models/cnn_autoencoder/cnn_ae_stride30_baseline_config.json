{
  "stage": "Stage 9 \u2014 1D CNN Autoencoder",
  "model": {
    "type": "one_dimensional_convolutional_autoencoder",
    "input_shape": [
      1,
      30
    ],
    "encoder": [
      {
        "layer": "Conv1d",
        "in_channels": 1,
        "out_channels": 8,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "output_shape": [
          8,
          30
        ]
      },
      {
        "layer": "ReLU"
      },
      {
        "layer": "MaxPool1d",
        "kernel_size": 2,
